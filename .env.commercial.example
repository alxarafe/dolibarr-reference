# Dolibarr Commercial Reference Profile - Example Configuration
# Copy to .env.commercial and adjust values as needed.
# These are LABORATORY-ONLY values. Do not use in production.

# Database configuration
DB_NAME=dolidb
DB_USER=dolidbuser
DB_PASSWORD=change_me_lab_only
DB_ROOT_PASSWORD=change_me_lab_only

# Dolibarr configuration
COMPANY_NAME="Alxarafe Reference Commercial"
COMPANY_COUNTRYCODE=ES
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_lab_only

# Commercial characterization profile.
# Propale + Commande + Workflow are the minimum set for the accepted-proposal
# to customer-order process. Api and Societe are required for controlled setup
# and observation.
ENABLE_MODULES=Api,Societe,Propale,Commande,Workflow

# Host port for Dolibarr web UI (loopback only)
DOLIBARR_REFERENCE_PORT=48242

# PHP date.timezone for the container (affects Dolibarr runtime timezone)
PHP_INI_DATE_TIMEZONE=Europe/Madrid

# Optional cron key for scheduled jobs
CRON_KEY=

# REST API key for the admin user (optional - if not set, a random key is generated by ./bin/up-commercial)
# NEVER commit a real API key to version control.
DOLIBARR_REFERENCE_API_KEY=
