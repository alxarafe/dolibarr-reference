# Dolibarr Reference Environment - Example Configuration
# Copy to .env and adjust values as needed.
# These are LABORATORY-ONLY values. Do not use in production.

# Database configuration
DB_NAME=dolidb
DB_USER=dolidbuser
DB_PASSWORD=change_me_lab_only
DB_ROOT_PASSWORD=change_me_lab_only

# Dolibarr configuration
COMPANY_NAME="Alxarafe Reference"
COMPANY_COUNTRYCODE=ES
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_lab_only

# Comma-separated list of Dolibarr modules to enable (without 'mod' prefix)
# Api = REST API, Societe = Third Parties
ENABLE_MODULES=Api,Societe

# Host port for Dolibarr web UI (loopback only)
DOLIBARR_REFERENCE_PORT=48240

# Optional cron key for scheduled jobs
CRON_KEY=