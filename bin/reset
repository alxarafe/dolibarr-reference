#!/usr/bin/env bash
# bin/reset - Destroy and recreate Dolibarr reference environment from scratch
# Strict shell policy
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
COMPOSE_FILE="$PROJECT_ROOT/compose.yaml"

# Ensure API key exists in .env (generates if missing)
# This also loads .env into environment
source "$PROJECT_ROOT/scripts/ensure-api-key.sh"

export DOLIBARR_REFERENCE_PORT="${DOLIBARR_REFERENCE_PORT:-48240}"

echo "=== RESET: Dolibarr Reference Environment ==="
echo "WARNING: This will DESTROY all laboratory data (database and documents)."
echo "This operation is IRREVERSIBLE for this environment."
echo ""
read -rp "Type 'YES' to confirm destruction and reset: " confirm
if [[ "$confirm" != "YES" ]]; then
    echo "Reset cancelled."
    exit 1
fi

echo ""
echo "Stopping services..."
docker compose -f "$COMPOSE_FILE" down -v

echo "Removing project volumes..."
# Get effective Compose project name from config (no jq dependency)
PROJECT_NAME=$(docker compose -f "$COMPOSE_FILE" config --format json 2>/dev/null | grep -o '"name": *"[^"]*"' | head -1 | sed 's/"name": *"\([^"]*\)"/\1/')
if [[ -z "$PROJECT_NAME" ]]; then
    echo "ERROR: Could not determine Compose project name from config" >&2
    exit 1
fi

# Remove volumes using docker compose down -v already does this, but be explicit
docker volume rm "${PROJECT_NAME}_dolibarr_db_data" 2>/dev/null || true
docker volume rm "${PROJECT_NAME}_dolibarr_documents" 2>/dev/null || true

echo "Starting fresh environment..."
docker compose -f "$COMPOSE_FILE" up -d

echo "Waiting for database to be healthy..."
timeout=120
elapsed=0
while [[ $elapsed -lt $timeout ]]; do
    db_status=$(docker compose -f "$COMPOSE_FILE" ps -q database | xargs docker inspect --format '{{.State.Health.Status}}' 2>/dev/null || echo "starting")
    if [[ "$db_status" == "healthy" ]]; then
        echo "Database is healthy."
        break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
done

if [[ $elapsed -ge $timeout ]]; then
    echo "ERROR: Database did not become healthy within ${timeout}s" >&2
    docker compose -f "$COMPOSE_FILE" logs database
    exit 1
fi

echo "Waiting for Dolibarr to complete installation and become healthy..."
timeout=240
elapsed=0
while [[ $elapsed -lt $timeout ]]; do
    web_status=$(docker compose -f "$COMPOSE_FILE" ps -q dolibarr | xargs docker inspect --format '{{.State.Health.Status}}' 2>/dev/null || echo "starting")
    if [[ "$web_status" == "healthy" ]]; then
        echo "Dolibarr is healthy."
        break
    fi
    sleep 3
    elapsed=$((elapsed + 3))
done

if [[ $elapsed -ge $timeout ]]; then
    echo "ERROR: Dolibarr did not become healthy within ${timeout}s" >&2
    docker compose -f "$COMPOSE_FILE" logs dolibarr
    exit 1
fi

# Get container IDs for version info
DB_CONTAINER=$(docker compose -f "$COMPOSE_FILE" ps -q database)
WEB_CONTAINER=$(docker compose -f "$COMPOSE_FILE" ps -q dolibarr)

echo ""
echo "=== Reset Complete - Environment Operational ==="
echo "URL: http://127.0.0.1:${DOLIBARR_REFERENCE_PORT}"
echo "API Explorer: http://127.0.0.1:${DOLIBARR_REFERENCE_PORT}/api/index.php"
echo ""
echo "Default credentials (from .env or defaults):"
echo "  Login: ${ADMIN_LOGIN:-admin}"
echo "  Password: (see .env or .env.example)"
echo ""
echo "REST API Authentication:"
# Mask the key for display (first 8, last 4) - safe under set -u
if [[ -n "${DOLIBARR_REFERENCE_API_KEY:-}" ]]; then
    masked_key="${DOLIBARR_REFERENCE_API_KEY:0:8}****${DOLIBARR_REFERENCE_API_KEY: -4}"
    echo "  DOLAPIKEY: ${masked_key}"
else
    echo "  DOLAPIKEY: (not configured)"
fi
echo "  (Full key stored in .env)"
echo ""
echo "Database version:"
docker exec "$DB_CONTAINER" mariadb --version 2>/dev/null || echo "  Unable to query"
echo ""
echo "Dolibarr version:"
docker exec "$WEB_CONTAINER" grep "define('DOL_MINOR_VERSION'" /var/www/html/version.inc.php 2>/dev/null | sed "s/.*'DOL_MINOR_VERSION', '\([^']*\)'.*/\1/" | sed 's/^/  24./' || echo "  Unable to query"