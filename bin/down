#!/usr/bin/env bash
# bin/down - Stop Dolibarr reference environment (preserves volumes)
# Strict shell policy
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
COMPOSE_FILE="$PROJECT_ROOT/compose.yaml"

echo "=== Stopping Dolibarr Reference Environment ==="
echo "Stopping services (volumes preserved)..."

docker compose -f "$COMPOSE_FILE" down

echo "Services stopped. Data volumes preserved."
echo "To remove volumes, use: ./bin/reset"