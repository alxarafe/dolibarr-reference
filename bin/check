#!/usr/bin/env bash
# bin/check - Validate Dolibarr reference environment from a clean state
# Strict shell policy
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
COMPOSE_FILE="$PROJECT_ROOT/compose.yaml"

# Use isolated project name for check
CHECK_PROJECT="dolibarr-reference-check"

# Load .env.example for defaults (not .env to avoid developer's credentials)
ENV_FILE="$PROJECT_ROOT/.env.example"
if [[ ! -f "$ENV_FILE" ]]; then
    echo "ERROR: .env.example not found" >&2
    exit 1
fi

set -a
# shellcheck source=/dev/null
source "$ENV_FILE"
set +a

# Generate ephemeral API key for this check run
EPHEMERAL_API_KEY=$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | xxd -p -c 32)

# Use a different port for isolated check to avoid conflicts
export DOLIBARR_REFERENCE_PORT="48241"
export COMPOSE_PROJECT_NAME="$CHECK_PROJECT"
export DOLIBARR_REFERENCE_API_KEY="$EPHEMERAL_API_KEY"

echo "=== Dolibarr Reference Environment Validation ==="
echo "Isolated project: $CHECK_PROJECT"
echo "Ephemeral API key: ${EPHEMERAL_API_KEY:0:8}****${EPHEMERAL_API_KEY: -4}"
echo ""

# Initialize CHECK_TEMP_DIR early so cleanup can safely handle it
CHECK_TEMP_DIR=""

cleanup() {
    local exit_code=$?
    echo ""
    echo "--- Cleanup ---"
    # Clean up temporary directory if it was created
    if [[ -n "$CHECK_TEMP_DIR" && -d "$CHECK_TEMP_DIR" ]]; then
        rm -rf "$CHECK_TEMP_DIR"
    fi
    # Remove isolated Compose resources
    docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" down -v --remove-orphans 2>/dev/null || true
    # Ensure volumes are removed
    docker volume rm "${CHECK_PROJECT}_dolibarr_db_data" 2>/dev/null || true
    docker volume rm "${CHECK_PROJECT}_dolibarr_documents" 2>/dev/null || true
    # Force remove any leftover containers
    docker rm -f "${CHECK_PROJECT}-database-1" "${CHECK_PROJECT}-dolibarr-1" 2>/dev/null || true
    # Remove project network if it exists
    docker network rm "${CHECK_PROJECT}_dolibarr_net" 2>/dev/null || true
    if [[ $exit_code -ne 0 ]]; then
        echo "VALIDATION FAILED" >&2
    else
        echo "VALIDATION PASSED"
    fi
    exit $exit_code
}
trap cleanup EXIT

# Pre-cleanup: ensure no leftover resources from previous runs
docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" down -v --remove-orphans 2>/dev/null || true
docker volume rm "${CHECK_PROJECT}_dolibarr_db_data" 2>/dev/null || true
docker volume rm "${CHECK_PROJECT}_dolibarr_documents" 2>/dev/null || true
docker rm -f "${CHECK_PROJECT}-database-1" "${CHECK_PROJECT}-dolibarr-1" 2>/dev/null || true

# Fresh database: start MariaDB
echo "1/10 Starting MariaDB..."
docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" up -d database

# Wait for database readiness
echo "2/10 Waiting for database readiness..."
timeout=120
elapsed=0
while [[ $elapsed -lt $timeout ]]; do
    db_status=$(docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" ps -q database | xargs docker inspect --format '{{.State.Health.Status}}' 2>/dev/null || echo "starting")
    if [[ "$db_status" == "healthy" ]]; then
        echo "   Database healthy."
        break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
done
if [[ $elapsed -ge $timeout ]]; then
    echo "   ERROR: Database not ready" >&2
    docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" logs database
    exit 1
fi

# Start Dolibarr
echo "3/10 Starting Dolibarr..."
docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" up -d dolibarr

# Wait for Dolibarr automatic installation and web readiness
echo "4/10 Waiting for Dolibarr installation and web readiness..."
timeout=240
elapsed=0
while [[ $elapsed -lt $timeout ]]; do
    web_status=$(docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" ps -q dolibarr | xargs docker inspect --format '{{.State.Health.Status}}' 2>/dev/null || echo "starting")
    if [[ "$web_status" == "healthy" ]]; then
        echo "   Dolibarr healthy."
        break
    fi
    sleep 3
    elapsed=$((elapsed + 3))
done
if [[ $elapsed -ge $timeout ]]; then
    echo "   ERROR: Dolibarr not ready" >&2
    docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" logs dolibarr
    exit 1
fi

# Get container IDs
DB_CONTAINER=$(docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" ps -q database)
WEB_CONTAINER=$(docker compose -f "$COMPOSE_FILE" -p "$CHECK_PROJECT" ps -q dolibarr)

# Wait for API key provisioning to complete (docker-init.d scripts run asynchronously)
echo "4b/14 Waiting for API key provisioning..."
timeout=60
elapsed=0
while [[ $elapsed -lt $timeout ]]; do
    # Check if the provisioning script has run by looking for the log entry
    if docker logs "$WEB_CONTAINER" 2>&1 | grep -q "provision-api-key.*API key provisioned successfully"; then
        echo "   API key provisioned."
        break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
done
if [[ $elapsed -ge $timeout ]]; then
    echo "   WARNING: API key provisioning log not found, attempting manual provisioning..." >&2
    # Try to run the provisioning script manually
    if docker exec "$WEB_CONTAINER" php /var/www/scripts/docker-init.d/90-provision-api-key.php 2>&1 | grep -q "API key provisioned successfully"; then
        echo "   API key provisioned manually."
    else
        echo "   ERROR: API key provisioning failed" >&2
        docker logs "$WEB_CONTAINER" 2>&1 | grep -i "provision-api-key" || echo "   No provisioning logs found"
        exit 1
    fi
fi

# Resolve Dolibarr database prefix from conf.php
# Use PHP to reliably parse the configuration file
DB_PREFIX=$(docker exec "$WEB_CONTAINER" php -r "
require '/var/www/html/conf/conf.php';
echo \$dolibarr_main_db_prefix ?? 'llx_';
" 2>/dev/null | tr -d '\r\n')
if [[ -z "$DB_PREFIX" ]]; then
    DB_PREFIX="llx_"
fi
echo "   Database prefix: $DB_PREFIX"

# Verify HTTP response
echo "5/10 Verifying HTTP response..."
if ! curl -fsS "http://127.0.0.1:${DOLIBARR_REFERENCE_PORT}/" >/dev/null; then
    echo "   ERROR: HTTP request failed" >&2
    exit 1
fi
echo "   HTTP 200 OK"

# Verify expected Dolibarr installation
echo "6/10 Verifying Dolibarr installation..."
dolibarr_version=$(docker exec "$WEB_CONTAINER" grep "define('DOL_MINOR_VERSION'" /var/www/html/version.inc.php 2>/dev/null | sed "s/.*'DOL_MINOR_VERSION', '\([^']*\)'.*/\1/" | tr -d '\r\n' || echo "unknown")
# Reconstruct full version from major.minor
dolibarr_version="24.${dolibarr_version}"
if [[ "$dolibarr_version" != "24.0.1" ]]; then
    echo "   ERROR: Unexpected Dolibarr version: $dolibarr_version (expected 24.0.1)" >&2
    exit 1
fi
echo "   Version: $dolibarr_version"

# Verify own-company initialization
echo "7/10 Verifying company initialization..."
company_name=$(docker exec "$DB_CONTAINER" mariadb -u"$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" -sN -e "SELECT value FROM ${DB_PREFIX}const WHERE name='MAIN_INFO_SOCIETE_NOM' LIMIT 1;" 2>/dev/null | tr -d '\r\n' || echo "")
if [[ "$company_name" != "Alxarafe Reference" ]]; then
    echo "   ERROR: Company name mismatch: '$company_name' (expected 'Alxarafe Reference')" >&2
    exit 1
fi
echo "   Company: $company_name"

# Verify REST module is enabled
echo "8/10 Verifying REST API module..."
api_enabled=$(docker exec "$DB_CONTAINER" mariadb -u"$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" -sN -e "SELECT COUNT(*) FROM ${DB_PREFIX}const WHERE name='MAIN_MODULE_API' AND value='1';" 2>/dev/null | tr -d '\r\n' || echo "0")
if [[ "$api_enabled" != "1" ]]; then
    echo "   ERROR: REST API module not enabled" >&2
    exit 1
fi
echo "   REST API module: enabled"

# Verify Third Parties module is enabled
societe_enabled=$(docker exec "$DB_CONTAINER" mariadb -u"$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" -sN -e "SELECT COUNT(*) FROM ${DB_PREFIX}const WHERE name='MAIN_MODULE_SOCIETE' AND value='1';" 2>/dev/null | tr -d '\r\n' || echo "0")
if [[ "$societe_enabled" != "1" ]]; then
    echo "   ERROR: Third Parties (Societe) module not enabled" >&2
    exit 1
fi
echo "   Third Parties module: enabled"

# Verify authenticated REST request works
# (functional test also proves API key was provisioned and works)
echo "9/10 Testing authenticated REST API access..."
BASE_URL="http://127.0.0.1:${DOLIBARR_REFERENCE_PORT}"

# Positive test: valid API key
# Use /users/info endpoint which returns 200 with current user info when authenticated
echo "   Testing valid API key (expecting HTTP 200)..."
response=$(curl -sS -w "\n%{http_code}" -H "DOLAPIKEY: ${EPHEMERAL_API_KEY}" -H "Accept: application/json" "${BASE_URL}/api/index.php/users/info" 2>/dev/null || echo -e "\n000")
http_code=$(echo "$response" | tail -1)
body=$(echo "$response" | head -n -1)

if [[ "$http_code" != "200" ]]; then
    echo "   ERROR: Expected HTTP 200, got HTTP $http_code" >&2
    echo "   Response: $body" >&2
    exit 1
fi

# Validate JSON response
if ! echo "$body" | docker exec -i "$WEB_CONTAINER" php -r 'json_decode(file_get_contents("php://stdin"), true);' >/dev/null 2>&1; then
    echo "   ERROR: Response is not valid JSON" >&2
    echo "   Response: $body" >&2
    exit 1
fi

# Verify authenticated user matches expected admin login
expected_login="${ADMIN_LOGIN:-admin}"
actual_login=$(echo "$body" | docker exec -i "$WEB_CONTAINER" php -r '$d=json_decode(file_get_contents("php://stdin"),true); echo $d["login"] ?? "";')
if [[ "$actual_login" != "$expected_login" ]]; then
    echo "   ERROR: Expected login '$expected_login', got '$actual_login'" >&2
    exit 1
fi
echo "   HTTP 200 OK - Valid JSON, authenticated user: $actual_login"

# Negative test: invalid API key (same endpoint)
echo "   Testing invalid API key (expecting HTTP 401)..."
invalid_key="invalid-key-$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | xxd -p -c 16)"
response=$(curl -sS -w "\n%{http_code}" -H "DOLAPIKEY: ${invalid_key}" -H "Accept: application/json" "${BASE_URL}/api/index.php/users/info" 2>/dev/null || echo -e "\n000")
http_code=$(echo "$response" | tail -1)

if [[ "$http_code" != "401" ]]; then
    echo "   ERROR: Expected HTTP 401 for invalid key, got HTTP $http_code" >&2
    exit 1
fi
echo "   HTTP 401 Unauthorized - Correctly rejects invalid key"

echo ""
mariadb_version=$(docker exec "$DB_CONTAINER" mariadb --version 2>/dev/null | head -1 || echo "unknown")
echo "   MariaDB: $mariadb_version"

# Verify charset/collation
charset=$(docker exec "$DB_CONTAINER" mariadb -u"$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" -sN -e "SHOW VARIABLES LIKE 'character_set_database';" 2>/dev/null | awk '{print $2}' || echo "unknown")
collation=$(docker exec "$DB_CONTAINER" mariadb -u"$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" -sN -e "SHOW VARIABLES LIKE 'collation_database';" 2>/dev/null | awk '{print $2}' || echo "unknown")
echo "   Database charset: $charset"
echo "   Database collation: $collation"

if [[ "$charset" != "utf8mb4" ]] || [[ "$collation" != "utf8mb4_general_ci" ]]; then
    echo "   ERROR: Database charset/collation mismatch (expected utf8mb4/utf8mb4_general_ci)" >&2
    exit 1
fi

# Verify Swagger endpoint and descriptor (DOL-REF-002)
echo "10/14 Verifying Swagger endpoint..."
SWAGGER_URL="${BASE_URL}/api/index.php/explorer/swagger.json"
swagger_response=$(curl -sS -w "\n%{http_code}" -H "DOLAPIKEY: ${EPHEMERAL_API_KEY}" -H "Accept: application/json" "$SWAGGER_URL" 2>/dev/null || echo -e "\n000")
swagger_http_code=$(echo "$swagger_response" | tail -1)
swagger_body=$(echo "$swagger_response" | head -n -1)

if [[ "$swagger_http_code" != "200" ]]; then
    echo "   ERROR: Swagger endpoint returned HTTP $swagger_http_code" >&2
    exit 1
fi

if ! echo "$swagger_body" | docker exec -i "$WEB_CONTAINER" php -r 'json_decode(file_get_contents("php://stdin"), true);' >/dev/null 2>&1; then
    echo "   ERROR: Swagger descriptor is not valid JSON" >&2
    exit 1
fi
echo "   Swagger endpoint reachable, valid JSON"

# Verify descriptor has paths
path_count=$(echo "$swagger_body" | docker exec -i "$WEB_CONTAINER" php -r '$d=json_decode(file_get_contents("php://stdin"),true); echo count($d["paths"] ?? []);' 2>/dev/null || echo "0")
if [[ "$path_count" -lt 1 ]]; then
    echo "   ERROR: Swagger descriptor has no paths" >&2
    exit 1
fi
echo "   Paths found: $path_count"

# Verify /users/info exists in descriptor
if ! echo "$swagger_body" | docker exec -i "$WEB_CONTAINER" php -r '$d=json_decode(file_get_contents("php://stdin"),true); exit(isset($d["paths"]["/users/info"]) ? 0 : 1);' >/dev/null 2>&1; then
    echo "   ERROR: /users/info not found in Swagger descriptor" >&2
    exit 1
fi
echo "   /users/info present in descriptor"

# Verify technical capture can be generated and matches baseline
echo "11/14 Verifying technical capture generation..."
CHECK_TEMP_DIR=$(mktemp -d)

# Copy process-swagger.php to the check container (required for capture)
docker cp "$PROJECT_ROOT/scripts/process-swagger.php" "$WEB_CONTAINER:/var/www/scripts/process-swagger.php" 2>/dev/null || true

# Invoke the single authoritative capture engine
CAPTURE_OUTPUT_DIR="$CHECK_TEMP_DIR/capture"
mkdir -p "$CAPTURE_OUTPUT_DIR"

export BASE_URL
export API_KEY="$EPHEMERAL_API_KEY"
export DB_CONTAINER
export DB_USER
export DB_PASSWORD
export DB_NAME
export WEB_CONTAINER
export OUTPUT_DIR="$CAPTURE_OUTPUT_DIR"

"$PROJECT_ROOT/scripts/capture-technical.sh"

echo "   Technical capture generated successfully"

# Compare with committed baseline
echo "12/14 Comparing with committed baseline..."
BASELINE_DIR="$PROJECT_ROOT/reference/baseline"
if [[ ! -d "$BASELINE_DIR" ]]; then
    echo "   ERROR: Baseline directory not found at $BASELINE_DIR" >&2
    exit 1
fi

# Compare swagger.json (normalized)
if ! diff -u "$BASELINE_DIR/swagger.json" "$CAPTURE_OUTPUT_DIR/swagger.json" >/dev/null 2>&1; then
    echo "   ERROR: Swagger descriptor drift detected vs committed baseline" >&2
    echo "   Run ./bin/capture-technical on baseline to update" >&2
    diff -u "$BASELINE_DIR/swagger.json" "$CAPTURE_OUTPUT_DIR/swagger.json" | head -50 >&2
    exit 1
fi
echo "   swagger.json matches baseline"

# Compare api-inventory.tsv
if ! diff -u "$BASELINE_DIR/api-inventory.tsv" "$CAPTURE_OUTPUT_DIR/api_inventory.tsv" >/dev/null 2>&1; then
    echo "   ERROR: API inventory drift detected vs committed baseline" >&2
    diff -u "$BASELINE_DIR/api-inventory.tsv" "$CAPTURE_OUTPUT_DIR/api_inventory.tsv" | head -50 >&2
    exit 1
fi
echo "   api-inventory.tsv matches baseline"

# Compare technical-reference.json (including charset/collation as strict evidence)
# We compare the normalized versions using PHP (no host jq dependency)
docker exec -i "$WEB_CONTAINER" php -r '
$baseline = json_decode(file_get_contents("php://stdin"), true);
ksort($baseline);
echo json_encode($baseline, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
' < "$BASELINE_DIR/technical-reference.json" > "$CHECK_TEMP_DIR/baseline_tr.json"

docker exec -i "$WEB_CONTAINER" php -r '
$check = json_decode(file_get_contents("php://stdin"), true);
ksort($check);
echo json_encode($check, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
' < "$CAPTURE_OUTPUT_DIR/technical-reference.json" > "$CHECK_TEMP_DIR/check_tr.json"
if ! diff -u "$CHECK_TEMP_DIR/baseline_tr.json" "$CHECK_TEMP_DIR/check_tr.json" >/dev/null 2>&1; then
    echo "   ERROR: Technical reference drift detected vs committed baseline" >&2
    diff -u "$CHECK_TEMP_DIR/baseline_tr.json" "$CHECK_TEMP_DIR/check_tr.json" | head -50 >&2
    exit 1
fi
echo "   technical-reference.json matches baseline"

echo ""
echo "13/14 Verifying no secrets in artifacts..."
# Check for API key in generated artifacts
if grep -q "$EPHEMERAL_API_KEY" "$CAPTURE_OUTPUT_DIR/swagger.json" 2>/dev/null; then
    echo "   ERROR: Ephemeral API key found in generated swagger.json" >&2
    exit 1
fi
if grep -q "$EPHEMERAL_API_KEY" "$CAPTURE_OUTPUT_DIR/technical-reference.json" 2>/dev/null; then
    echo "   ERROR: Ephemeral API key found in generated technical-reference.json" >&2
    exit 1
fi
echo "   No secrets detected in generated artifacts"

echo ""
echo "14/14 All technical reference validations passed"

echo ""
echo "=== All Checks Passed ==="
echo "Dolibarr $dolibarr_version operational with REST API and Third Parties modules."
echo "REST authentication validated: valid key -> 200, invalid key -> 401"
echo "Technical reference validated: Swagger descriptor, API inventory, and metadata match committed baseline"